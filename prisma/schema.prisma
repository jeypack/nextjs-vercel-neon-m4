generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  firstName    String?
  lastName     String?
  passwordHash String
  image        String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions      Session[]
  pantryItems   PantryItem[]
  recipes       Recipe[]
  mealPlans     MealPlan[]
  shoppingItems ShoppingItem[]
}

model Session {
  id        String   @id @default(cuid())
  userId    Int
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model IngredientCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ingredients Ingredient[]

  @@index([sortOrder, name])
}

model Ingredient {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  categoryId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category          IngredientCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  pantryItems       PantryItem[]
  recipeIngredients RecipeIngredient[]
  shoppingItems     ShoppingItem[]

  @@index([categoryId, name])
}

model RecipeCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipes Recipe[]

  @@index([sortOrder, name])
}

model Recipe {
  id           Int      @id @default(autoincrement())
  userId       Int?
  categoryId   Int
  title        String
  description  String?
  instructions String
  prepTime     Int
  servings     Int      @default(2)
  imageUrl     String?
  isPublic     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  category    RecipeCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  ingredients RecipeIngredient[]
  mealPlans   MealPlan[]

  @@index([userId, title])
  @@index([categoryId, title])
  @@index([isPublic, title])
}

model RecipeIngredient {
  id           Int     @id @default(autoincrement())
  recipeId     Int
  ingredientId Int
  amount       Float?
  unit         String?
  notes        String?

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([recipeId, ingredientId])
  @@index([ingredientId])
}

model PantryItem {
  id           Int       @id @default(autoincrement())
  userId       Int
  ingredientId Int
  quantity     Float?
  unit         String?
  expiresAt    DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([userId, ingredientId])
  @@index([userId, expiresAt])
}

model MealPlan {
  id        Int      @id @default(autoincrement())
  userId    Int
  recipeId  Int
  date      DateTime @db.Date
  mealType  MealType
  notes     String?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, date, mealType])
  @@index([recipeId])
}

model ShoppingItem {
  id           Int      @id @default(autoincrement())
  userId       Int
  ingredientId Int
  amount       Float?
  unit         String?
  isBought     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([userId, isBought])
  @@index([userId, ingredientId])
}
