generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum UnitType {
  WEIGHT
  VOLUME
  COUNT
  OTHER
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  firstName    String?
  lastName     String?
  passwordHash String
  image        String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions      Session[]
  pantryItems   PantryItem[]
  recipes       Recipe[]
  mealPlans     MealPlan[]
  shoppingItems ShoppingItem[]
}

model Session {
  id        String   @id @default(cuid())
  userId    Int
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model IngredientCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ingredients Ingredient[]

  @@index([sortOrder, name])
}

model Ingredient {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  categoryId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category          IngredientCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  pantryItems       PantryItem[]
  recipeIngredients RecipeIngredient[]
  shoppingItems     ShoppingItem[]

  @@index([categoryId, name])
}

model RecipeCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipes Recipe[]

  @@index([sortOrder, name])
}

model Unit {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  symbol    String   @unique
  type      UnitType
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pantryItems       PantryItem[]
  pantryPackageItems PantryItem[] @relation("PantryPackageUnit")
  recipeIngredients RecipeIngredient[]
  shoppingItems     ShoppingItem[]

  @@index([type, sortOrder])
}

model Recipe {
  id           Int        @id @default(autoincrement())
  userId       Int?
  categoryId   Int
  title        String
  description  String?
  instructions String
  prepTime     Int
  servings     Int        @default(2)
  difficulty   Difficulty @default(MEDIUM)
  imageUrl     String?
  isPublic     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  category    RecipeCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  ingredients RecipeIngredient[]
  mealPlans   MealPlan[]

  @@index([userId, title])
  @@index([categoryId, title])
  @@index([isPublic, title])
}

model RecipeIngredient {
  id           Int     @id @default(autoincrement())
  recipeId     Int
  ingredientId Int
  amount       Float?
  unitId       Int?
  notes        String?

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  unit       Unit?      @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([recipeId, ingredientId])
  @@index([ingredientId])
  @@index([unitId])
}

model PantryItem {
  id           Int     @id @default(autoincrement())
  userId       Int
  ingredientId Int
  unitId        Int
  packageUnitId Int?
  
  quantity     Float?
  packageSize   Float?
  drainedWeight Float?

  expiresAt DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  unit          Unit  @relation(fields: [unitId], references: [id], onDelete: Restrict)
  packageUnit   Unit? @relation("PantryPackageUnit", fields: [packageUnitId], references: [id], onDelete: Restrict)

  @@index([userId, ingredientId])
  @@index([userId, expiresAt])
}

model ShoppingItem {
  id           Int      @id @default(autoincrement())
  userId       Int
  ingredientId Int
  amount       Float?
  unitId       Int
  isBought     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  unit       Unit       @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@index([userId, isBought])
  @@index([userId, ingredientId])
  @@index([unitId])
}

model MealPlan {
  id        Int      @id @default(autoincrement())
  userId    Int
  recipeId  Int
  date      DateTime @db.Date
  mealType  MealType
  notes     String?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, date, mealType])
  @@index([recipeId])
}
